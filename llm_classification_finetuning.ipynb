        "# df_b[\"label\"] = df[\"winner_model_b\"]\n",
        "# df_b[\"tie\"] = df[\"winner_tie\"]\n",
        "\n",
        "# # labels = [\"winner_model_a\",\"winner_model_b\",\"winner_tie\"]\n",
        "# # df_new[labels] = df[labels]\n",
        "\n",
        "# # df_new.head()"
