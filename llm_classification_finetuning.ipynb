            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "dataframe",
              "variable_name": "df_a",
              "summary": "{\n  \"name\": \"df_a\",\n  \"rows\": 57477,\n  \"fields\": [\n    {\n      \"column\": \"text_a\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 57003,\n        \"samples\": [\n          \"Sally (a girl) has 3 brothers. Each brother has 2 sisters. How many sisters does sally have? - Sally has 4 sisters.\\n\\nSally has 3 brothers, so she has 3 siblings in total. Each of Sally's brothers has 2 sisters, so between them, Sally's brothers have 6 sisters. This means that Sally's total number of sisters is 6 minus her own 3 brothers, which is 4. 1\",\n          \"Sally (a girl) has 3 brothers. Each brother has 2 sisters. How many sisters does Sally have? - 3 1\",\n          \"Write hello in Japanese  - \\u3053\\u3093\\u306b\\u3061\\u306f (Konnichiwa) 2\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"encode_fail_a\",\n      \"properties\": {\n        \"dtype\": \"boolean\",\n        \"num_unique_values\": 2,\n        \"samples\": [\n          true,\n          false\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
          },
          "metadata": {},
          "execution_count": 6
