      "cell_type": "code",
      "source": [
        "def make_pairs(row,response):\n",
        "  encode_fail = False\n",
        "\n",
        "  try:\n",
        "      prompt = row.prompt.encode(\"utf-8\").decode(\"utf-8\")\n",
        "  except:\n",
        "      prompt = \"\"\n",
        "      encode_fail = True\n",
        "\n",
        "  try:\n",
        "      given_response = row[f\"response_{response}\"].encode(\"utf-8\").decode(\"utf-8\")\n",
        "  except:\n",
        "      given_response = \"\"\n",
        "      encode_fail = True\n",
        "\n",
        "  text = prompt + \" - \" + given_response\n",
        "  text = re.sub(r\"'[\\x00-\\x1F\\x7F]'\", r\" \", text)\n",
        "\n",
        "  label = str(row[f\"winner_model_{response}\"]+1)\n",
        "\n",
        "  text = text + \" \" + label\n",
        "\n",
        "  return pd.Series({f'text_{response}': text, f'encode_fail_{response}': encode_fail})\n",
        "\n",
        "# # df[[\"text\",\"encode_fail\"]] = df.apply(make_pairs, axis=1,response=\"a\")\n",
        "# df_a = df.apply(make_pairs, axis=1,response = \"a\") # Apply row-wise\n",
